# ----------------------------------------
# Copy this file to ".env" and fill in your own values.
# ----------------------------------------

# Server
PORT=5000

# Comma-separated list of origins allowed to call the API, e.g.
#   CORS_ORIGIN=https://your-domain.com
# Leave blank during local dev / while testing on a VPS - it defaults to
# allowing every origin, which is safe here since auth uses a Bearer token
# (not a cookie). Set it once the admin panel has a real domain.
CORS_ORIGIN=

# MySQL (local database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=auth_module_db

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# Admin account created by the seed script (npm run seed) - signs in at /admin
ADMIN_NAME=Tejas Mehar
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin123

# User account created by the seed script (npm run seed:user) - signs in at /user
USER_NAME=User
USER_EMAIL=user@gmail.com
USER_PASSWORD=User123

# Email. Used for the "Forgot Password" OTP and for the landing page enquiry
# form. With Gmail, SMTP_PASSWORD is a 16-character App Password (Google
# Account -> Security -> 2-Step Verification -> App passwords), NOT the
# account password. The spaces Google shows it with are stripped for you.
# If you don't have SMTP credentials yet, leave these blank -
# the OTP will simply be printed to the backend console instead of emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# The name outgoing mail shows up as in the recipient's inbox. The address is
# always SMTP_USER - Gmail will not send as a mailbox it does not own.
MAIL_FROM_NAME=

# Where the landing page enquiry form is delivered. Leave blank - which is the
# normal setting - and it goes to every active admin account in the database,
# so it follows whoever runs the shop without an edit here. Set it (comma-
# separated for more than one) only to override that with a fixed inbox. Set explicitly
# so the shop's inbox does not quietly change if the sending mailbox does.
ENQUIRY_EMAIL=shivshaktisilver12@gmail.com
