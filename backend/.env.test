# Configuration for the automated test suite.
#
# The tests run against a REAL MySQL database, deliberately: the things most
# worth testing here - the holding lock, the settlement transaction, DECIMAL
# precision, cross-table email uniqueness - are properties of the database, and
# a mocked driver would report them all as passing.
#
# It is a SEPARATE schema from the development one. tests/setup/schema.js drops
# and rebuilds it on every run, so pointing DB_NAME at a database you care
# about would destroy it.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_NAME=auth_module_db_test

# A fixed secret so a token minted in one test file verifies in another.
JWT_SECRET=test-secret-not-used-anywhere-real
JWT_EXPIRES_IN=1d

# Left blank on purpose: sendEmail.js then logs the OTP instead of sending it,
# which is how the password-reset tests read the code back.
SMTP_USER=
SMTP_PASSWORD=
