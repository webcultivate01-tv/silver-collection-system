{
  "name": "auth-module-backend",
  "version": "1.0.0",
  "description": "Admin authentication module - Node.js, Express, MySQL, JWT (MVC pattern)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "seed": "node seeder/adminSeeder.js",
    "seed:user": "node seeder/userSeeder.js",
    "seed:employee-users": "node seeder/employeeUsersSeeder.js",
    "seed:demo": "node seeder/demoSeeder.js",
    "seed:bulk": "node seeder/bulkSeeder.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "check:email": "node scripts/checkEmail.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2",
    "vitest": "^2.1.9"
  }
}
